# --- Proveedor de IA ---
# Cual "cerebro" usa el bot: groq | gemini | anthropic | mock
#  - groq:      gratis, rapido, bueno para probar (recomendado para empezar)
#  - gemini:    nivel gratuito de Google
#  - anthropic: Claude, la mejor calidad para atencion al cliente (pago por uso)
#  - mock:      sin IA, respuestas de prueba por palabras clave (sin costo)
LLM_PROVIDER=groq

# --- Groq (gratis, compatible OpenAI) ---
# Key gratis en https://console.groq.com/keys (empieza por gsk_...)
GROQ_API_KEY=gsk_tu-key-aqui
GROQ_MODEL=llama-3.3-70b-versatile

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui
ANTHROPIC_MODEL=claude-opus-4-8

# --- Google Gemini ---
GEMINI_API_KEY=tu-key-de-google-aistudio
GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp Cloud API (Meta) ---
# Token de acceso permanente del System User de Meta.
WHATSAPP_TOKEN=EAAG...tu-token
# ID del numero de telefono (Phone number ID), lo da Meta en la config de la app.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Token que TU inventas; debe coincidir con el que pongas en Meta al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=inventa-un-token-secreto

# --- Servidor ---
PORT=3000
